# ==========================================
# LongPsychAgent Core
# ==========================================

LONGPSYCH_ROOT=.
LONGPSYCH_MODEL=./models/BAAI/bge-large-zh-v1___5
LONGPSYCH_INDEX_DIR=./data/indexes

LONGPSYCH_DEVICE=cuda
LONGPSYCH_BATCH_SIZE=16
LONGPSYCH_CANDIDATE_K=100
LONGPSYCH_VERIFY_HASHES=true

# ==========================================
# FastAPI
# ==========================================

LONGPSYCH_API_BASE_URL=http://127.0.0.1:8000
LONGPSYCH_API_TIMEOUT_SECONDS=60

# ==========================================
# MCP
# ==========================================

LONGPSYCH_MCP_TRANSPORT=streamable-http
LONGPSYCH_MCP_HOST=127.0.0.1
LONGPSYCH_MCP_PORT=8001
LONGPSYCH_MCP_URL=http://127.0.0.1:8001/mcp
LONGPSYCH_MCP_LOG_LEVEL=INFO

# ==========================================
# LangGraph SQLite
# ==========================================

LONGPSYCH_AGENT_DB_PATH=./data/agent/longpsych_agent_v3.sqlite

# ==========================================
# LLM
# ==========================================

LONGPSYCH_LLM_API_KEY=
LONGPSYCH_LLM_BASE_URL=
LONGPSYCH_LLM_MODEL=gpt-4o-mini
LONGPSYCH_LLM_TEMPERATURE=0.2
LONGPSYCH_LLM_TIMEOUT=45
